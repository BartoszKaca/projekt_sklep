# Production Environment Configuration (Docker Version)
# =======================================================
# Użyj tego pliku jeśli hostujesz MySQL w Docker kontenerze

APP_NAME="Rap Shop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rapshop.pl

# Locale Configuration
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

# Maintenance
APP_MAINTENANCE_DRIVER=file

# Performance
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ========================================
# DATABASE CONFIGURATION (Docker MySQL)
# ========================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sklep_laravel
DB_USERNAME=laravel
DB_PASSWORD=your_secure_mysql_password_here_change_it
DB_ROOT_PASSWORD=your_secure_root_password_here_change_it

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=rapshop.pl

# Broadcast Configuration
BROADCAST_CONNECTION=log

# Filesystem Configuration
FILESYSTEM_DISK=local
FILESYSTEM_VISIBILITY=private

# Queue Configuration
QUEUE_CONNECTION=database

# Cache Configuration
CACHE_STORE=database
CACHE_PREFIX=rapshop_prod_

# ========================================
# MAIL CONFIGURATION - MAILTRAP PRODUCTION
# ========================================
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_token
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@rapshop.pl
MAIL_FROM_NAME="${APP_NAME}"

# ========================================
# PAYMENT GATEWAY - PAYU (PRODUCTION)
# ========================================
PAYU_ENVIRONMENT=secure
PAYU_POS_ID=your_production_pos_id
PAYU_SIGNATURE_KEY=your_production_signature_key
PAYU_CLIENT_ID=your_production_client_id
PAYU_CLIENT_SECRET=your_production_client_secret

# ========================================
# SECURITY
# ========================================
# Trusted Proxies (za Nginx)
TRUSTED_PROXIES=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_MINUTES=1
