# =============================================================================
# KONFIGURACJA PRODUKCYJNA - SKLEP LARAVEL
# =============================================================================
# Skopiuj ten plik jako .env na serwerze i uzupełnij wartości
# Na serwerze: cp env.production.example .env
# =============================================================================

APP_NAME="RapShop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Warsaw
APP_URL=http://bartoszkaca.online

# Logowanie
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =============================================================================
# BAZA DANYCH (Docker)
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sklep_laravel
DB_USERNAME=laravel
DB_PASSWORD=laravel
DB_ROOT_PASSWORD=root

# =============================================================================
# CACHE & SESJE
# =============================================================================
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Redis (Docker)
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# =============================================================================
# KOLEJKI
# =============================================================================
QUEUE_CONNECTION=redis

# =============================================================================
# MAIL
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=live.smtp.mailtra.io
MAIL_PORT=587
MAIL_USERNAME=api
MAIL_PASSWORD=418ab9d7d90db0d04e9aa267b0096459
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="sklep@tbartoszkaca.online"
MAIL_FROM_NAME="${APP_NAME}"

# Alternatywnie: Amazon SES
# MAIL_MAILER=ses
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-1

# =============================================================================
# PŁATNOŚCI - PayU
# =============================================================================
PAYU_MERCHANT_POS_ID=501217
PAYU_SIGNATURE_KEY=12ba91835be2948ec0800d7c658e0e56
PAYU_OAUTH_CLIENT_ID=501217
PAYU_OAUTH_CLIENT_SECRET=453cd7ba50012887593cf23dfdf7fcd5
PAYU_ENV=sandbox

# =============================================================================
# STORAGE (opcjonalnie S3)
# =============================================================================
FILESYSTEM_DISK=local

# Dla Amazon S3:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
# AWS_BUCKET=sklep-storage
# AWS_URL=

# =============================================================================
# BEZPIECZEŃSTWO
# =============================================================================
BCRYPT_ROUNDS=12

