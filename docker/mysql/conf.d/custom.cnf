[mysqld]
# WAŻNE: Rozwiązuje błąd lower_case_table_names
# Wartość 2 = nazwy tabel zapisywane jak podane, porównywane lowercase
# Musi być ustawione PRZED inicjalizacją bazy danych!
lower_case_table_names=2

# Character set
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

# InnoDB settings
innodb_buffer_pool_size=256M
innodb_log_file_size=64M
innodb_flush_log_at_trx_commit=2
innodb_flush_method=O_DIRECT

# Connections
max_connections=150
max_allowed_packet=64M

# Query cache (wyłączony w MySQL 8.0+, ale zostawiam dla kompatybilności)
# query_cache_type=0

# Slow query log
slow_query_log=1
slow_query_log_file=/var/lib/mysql/slow-query.log
long_query_time=2

# Binary logs (opcjonalnie dla replikacji/recovery)
# log_bin=mysql-bin
# binlog_expire_logs_seconds=604800
# max_binlog_size=100M

# Timezone
default-time-zone='+01:00'

[mysql]
default-character-set=utf8mb4

[client]
default-character-set=utf8mb4

